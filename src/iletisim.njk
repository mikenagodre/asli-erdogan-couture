    <div>
      <!--
        NOT: Bu form şu an sadece görsel olarak hazır; GitHub Pages statik
        barındırma kullandığı için kendi başına e posta gönderemez. Formun
        gerçekten çalışması için action alanına bir form servisinin (örn.
        kendi sunucunuz, ya da Formspree benzeri bir servis) adresini
        eklemek gerekiyor. Bu konuyu birlikte değerlendirebiliriz.
      -->
      <form class="contact-form" onsubmit="return false;">
        <div>
          <label for="ad-soyad">Ad Soyad</label>
          <input type="text" id="ad-soyad" name="ad-soyad" placeholder="Adınız ve soyadınız" required />
        </div>
        <div>
          <label for="telefon">Telefon</label>
          <input type="tel" id="telefon" name="telefon" placeholder="0 (5xx) xxx xx xx" required />
        </div>
        <div>
          <label for="konu">İlgilendiğiniz Hizmet</label>
          <select id="konu" name="konu">
            <option>Gece Kıyafeti</option>
            <option>Özel Gelinlik</option>
            <option>Abiye</option>
            <option>Diğer</option>
          </select>
        </div>
        <div>
          <label for="mesaj">Mesajınız</label>
          <textarea id="mesaj" name="mesaj" rows="4" placeholder="Aklınızdaki tasarımı kısaca anlatabilirsiniz"></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="justify-self:start;">Gönder</button>
      </form>
